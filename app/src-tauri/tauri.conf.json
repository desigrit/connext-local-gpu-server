{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shambu",
  "version": "1.0.5",
  "identifier": "com.desigrit.shambu",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Shambu",
        "width": 1300,
        "height": 840,
        "minWidth": 360,
        "minHeight": 580,
        "resizable": true,
        "backgroundColor": "#F7F8F5",
        "theme": "Light",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Check on your private inference server.",
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "resources": {
      "../src/assets/brands/ORIGIN.txt": "licenses/Companion-brand-marks.txt",
      "../src/assets/brands/LICENSE-Ollama.txt": "licenses/Ollama.txt",
      "../assets/shambu/ORIGIN.txt": "licenses/Shambu-artwork.txt",
      "../src/assets/vines/ORIGIN.txt": "licenses/Shambu-vines.txt"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3Rjg3NzZERjE2MkI4QzkKUldUSnVHTHhiWGY0dDZzejdrMjJZWHgva3hvSVZTN1dMNVl5WjlkaXBMR1NUbDNkQWF0WDBhdWEK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
